INTERNAL_SECRET=replace-with-a-long-random-secret
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TRANSLATE_URL=https://api.sarvam.ai/translate
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# Sarvam Vision 2.1 through Document AI Parse.
SARVAM_VISION_MODEL=sarvam-vision-v1
SARVAM_VISION_TIMEOUT_SECONDS=180
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_USE_FP16=false
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION=tracevault_chunks
LAYA_MODEL=convaiinnovations/laya
HF_TOKEN=
HF_PROVIDER=hf-inference
LAYA_CALIBRATION_VALIDATED=false
INCIDENT_CONFIDENCE_THRESHOLD=0.60
SARVAM_DOC_AI_URL=https://api.sarvam.ai/doc-ai/v1/job
SARVAM_EXTRACT_MODEL=sarvam-vision-v1
WHISPER_MODEL=small
# OCR: local | auto | google | sarvam (default provider for /ocr). Local-language engine order for auto.
OCR_PROVIDER=auto
OCR_INDIC_ORDER=google,sarvam
GOOGLE_API_KEY=
# Translation provider for the English working copy: auto (Sarvam, else Google) | sarvam | google
TRANSLATE_PROVIDER=auto
# Case summaries / narrative (cloud modes) use the same Groq endpoint; override per purpose if needed.
LLM_EXTRACT_MODEL=qwen/qwen3.8-27b
LLM_SUMMARY_MODEL=qwen/qwen3.8-27b
