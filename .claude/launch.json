{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@tracevault/web"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "apps/api"],
      "port": 4000
    },
    {
      "name": "ml",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/run-ml.js"],
      "port": 8000
    },
    {
      "name": "web-smoke",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set API_TARGET=http://127.0.0.1:4100&& set WEB_PORT=5174&& npm run dev --workspace @tracevault/web"],
      "port": 5174
    }
  ]
}
