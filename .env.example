# --- api ---
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/tracevault?replicaSet=rs0
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
MASTER_KEK_BASE64=            # 32 bytes, base64 - wraps per-file data keys
ED25519_PRIVATE_KEY_PEM_PATH=./keys/audit_ed25519.pem
ML_BASE_URL=http://127.0.0.1:8000
ML_INTERNAL_SECRET=change-me
WORKER_IN_PROCESS=true
MAX_UPLOAD_MB=200
WEB_ORIGIN=http://localhost:5173

# --- ml service ---
INTERNAL_SECRET=change-me
ANTHROPIC_API_KEY=
LLM_EXTRACT_MODEL=claude-haiku-5-5
LLM_SUMMARY_MODEL=claude-sonnet-5-5
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- sarvam (voice + translation) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v4
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_DEFAULT_SPEAKER=shubh
SARVAM_BATCH_THRESHOLD_SEC=120
SARVAM_MAX_RPS=5
SARVAM_DAILY_AUDIO_SEC_CAP=7200
SARVAM_MOCK=false

# --- local fallbacks ---
WHISPER_MODEL=small
FFMPEG_PATH=ffmpeg
TESSERACT_PATH=tesseract

# --- optional hardening ---
# ClamAV (clamd over TCP). Unset = no virus scan. If set and the scanner is down, uploads are refused unless FAIL_OPEN=true.
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_FAIL_OPEN=false
# Per-user rate limits per minute
RL_UPLOAD_PER_MIN=60
RL_VOICE_PER_MIN=20
RL_LLM_PER_MIN=20

# --- trusted timestamping (RFC 3161, future spec F2) ---
# Empty TSA_PRIMARY_URL = off: nothing is created or sent. Only SHA-256 hashes ever leave the server.
# Dev example: https://freetsa.org/tsr  (confirm which authority a court will accept before production)
TSA_PRIMARY_URL=
TSA_FALLBACK_URL=
TSA_TRUST_PEM_PATH=            # PEM of the TSA root(s) you trust; enables 'trusted' status and offline openssl checks
TIMESTAMP_ANCHOR_EVERY_N=50    # stamp the audit head + Merkle root after this many new audit entries

# Optional: override DNS servers if mongodb+srv lookups fail (querySrv EBADRESP)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Google Cloud (Kannada OCR + translation fallback; official APIs, needs a key) ---
# Enable 'Cloud Translation API' and 'Cloud Vision API' for the key. Content is sent to Google, so each case opts in:
#   Settings > 'Reading text from images' (OCR) and 'Translating non-English text'. Empty key = feature unused.
GOOGLE_API_KEY=
TRANSLATE_PROVIDER=auto        # auto = Sarvam if available, else Google | sarvam | google

# --- deployment: everything but the ML service runs on Vercel (web = static, api = one serverless function) ---
# Set these as Vercel project env vars:
#   MONGO_URI            Atlas connection string (replica set; needed for audit-chain transactions)
#   ML_BASE_URL          public URL of the ML service (Cloud Run / Fly / Render); ML_INTERNAL_SECRET must match its INTERNAL_SECRET
#   JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, MASTER_KEK_BASE64
#   ED25519_PRIVATE_KEY_PEM   audit-checkpoint signing key as inline PEM (newlines as \n); there is no key file on Vercel
#   TSA_TRUST_PEM             optional inline PEM instead of TSA_TRUST_PEM_PATH
#   CRON_SECRET               any random string; Vercel Cron sends it as a Bearer token to /api/v1/internal/cron
#   TRUST_PROXY=1             one proxy hop (Vercel) in front of the API
#   WORKER_IN_PROCESS is ignored on Vercel: jobs run in post-response drains (jobs/kick.js) plus the cron backstop
#   JOB_CLAIM_BUDGET_MS=150000  how long one invocation keeps claiming jobs
